# ─────────────────────────────────────────────────────────────
# Ghost Lab SOC — environment configuration
#
# Copy this file to `.env` and fill in the values below.
# `.env` is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#
# Or run ./setup.sh to be prompted for the required values.
# ─────────────────────────────────────────────────────────────

# == MUST CHANGE ==============================================
# The repo is insecure/non-functional until these are set.

# Discord webhooks — bearer credentials, treat as secrets.
# Create in Discord: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_ALERTS=YOUR_ALERTS_WEBHOOK_URL
DISCORD_WEBHOOK_GENERAL=YOUR_GENERAL_WEBHOOK_URL

# Wazuh indexer client cert + key (mutual TLS auth to the indexer).
# Point these at the cert/key on the host running the agents.
WAZUH_CERT=/path/to/wazuh-certs/admin.pem
WAZUH_KEY=/path/to/wazuh-certs/admin-key.pem


# == MIGHT CHANGE ============================================
# Defaults below match the reference build. Edit to match your lab.

# Wazuh endpoints
WAZUH_INDEXER=https://192.168.200.2:9200
WAZUH_API=https://192.168.200.2:55000

# Green agent SSHes into the Wazuh box to stage detection rules
WAZUH_SSH_USER=wazuh
WAZUH_SSH_HOST=192.168.200.2

# Inter-agent messaging platform (Flask app in soc-messaging/)
SOC_API_URL=http://0.0.0.0:5000

# Optional: override where the messaging DB is written.
# Defaults to messages.db next to the messaging app if unset.
# SOC_DB_PATH=/opt/ghost-lab/soc-messaging/messages.db
